---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const applicationOrder = [
  'reachy-mini-jetson-assistant',
  'multi-modal-ai-studio',
  'live-vlm-webui',
  'openclaw',
  'nemoclaw',
];
const applications = (await getCollection('tutorials'))
  .filter((entry) => entry.data.category === 'Applications')
  .sort((a, b) => {
    const aSlug = a.slug.split('/').pop() || a.slug;
    const bSlug = b.slug.split('/').pop() || b.slug;
    return applicationOrder.indexOf(aSlug) - applicationOrder.indexOf(bSlug);
  });
---

<Layout
  title="Applications - Jetson AI Lab"
  description="Explore complete AI applications that combine reusable Jetson building blocks into end-to-end experiences."
>
  <section class="relative overflow-hidden bg-nvidia-black py-24 text-white">
    <div class="absolute inset-0 overflow-hidden">
      <div class="absolute -right-40 -top-40 h-96 w-96 rounded-full bg-nvidia-green/20 blur-3xl"></div>
      <div class="absolute -left-20 top-20 h-72 w-72 rounded-full bg-purple-500/10 blur-3xl"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <p class="mb-4 text-sm font-bold uppercase tracking-[0.18em] text-nvidia-green">
        Built on Jetson
      </p>
      <h1 class="text-5xl font-bold tracking-tight md:text-6xl">Applications</h1>
      <p class="mx-auto mt-6 max-w-3xl text-xl leading-relaxed text-nvidia-gray-300">
        Complete, end-to-end experiences that combine models, runtimes, interfaces,
        and Jetson-specific optimization.
      </p>
    </div>
  </section>

  <section class="border-b border-nvidia-gray-200 bg-nvidia-gray-50">
    <div class="mx-auto grid max-w-7xl gap-6 px-4 py-10 sm:px-6 md:grid-cols-[1fr_auto] md:items-center lg:px-8">
      <div>
        <h2 class="text-2xl font-bold text-nvidia-black">From building blocks to complete experiences</h2>
        <p class="mt-2 max-w-3xl leading-relaxed text-nvidia-gray-600">
          Applications show how multiple Jetson capabilities work together. For focused,
          reusable instructions that you can combine in your own project, use Tutorials.
        </p>
      </div>
      <a
        href="/tutorials"
        class="inline-flex items-center justify-center gap-2 rounded-lg bg-nvidia-green px-5 py-3 font-bold text-nvidia-black transition-colors hover:bg-nvidia-green/90"
      >
        Browse Tutorials
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="min-h-screen bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-12 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-sm font-bold uppercase tracking-wider text-nvidia-green">Application stories</p>
          <h2 class="mt-2 text-3xl font-bold text-nvidia-black md:text-4xl">See the complete experience</h2>
        </div>
        <p class="text-sm text-nvidia-gray-500">
          {applications.length} application{applications.length === 1 ? '' : 's'}
        </p>
      </div>

      <div class="mx-auto max-w-5xl space-y-6">
        {applications.map((application, index) => (
          <article class="group grid overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 shadow-sm lg:grid-cols-12">
            <div class:list={[
              'relative min-h-44 overflow-hidden bg-slate-200 sm:min-h-52 lg:col-span-5 lg:min-h-[250px]',
              index % 2 === 1 && 'lg:order-2',
            ]}>
              {application.data.hero_image ? (
                <img
                  src={application.data.hero_image}
                  alt=""
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
              ) : (
                <div class="absolute inset-0 bg-gradient-to-br from-slate-800 to-slate-950"></div>
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-black/45 via-transparent to-transparent"></div>
              <span class="absolute bottom-5 left-5 font-mono text-xs font-bold tracking-[0.18em] text-white/80">
                APPLICATION {String(index + 1).padStart(2, '0')}
              </span>
            </div>

            <div class:list={[
              'flex flex-col justify-center p-6 lg:col-span-7 lg:p-7',
              index % 2 === 1 && 'lg:order-1',
            ]}>
              <span class="w-fit rounded-full border border-nvidia-green/30 bg-nvidia-green/10 px-3 py-1 text-xs font-bold uppercase tracking-wider text-green-800">
                {application.data.section || 'Jetson application'}
              </span>
              <h3 class="mt-3 text-xl font-bold tracking-tight text-slate-950">
                {application.data.title}
              </h3>
              <p class="mt-3 text-sm leading-6 text-slate-600">
                {application.data.description}
              </p>
              <div class="mt-4 flex flex-wrap gap-2">
                {application.data.tags.slice(0, 3).map((tag) => (
                  <span class="rounded-md bg-white px-2.5 py-1 text-xs font-medium text-slate-600 ring-1 ring-slate-200">
                    {tag}
                  </span>
                ))}
              </div>
              <a
                href={`/applications/${application.slug.split('/').pop()}`}
                class="mt-5 inline-flex w-fit items-center gap-2 rounded-lg bg-slate-950 px-4 py-2 text-sm font-bold text-white transition-colors hover:bg-nvidia-green hover:text-slate-950"
              >
                Explore application
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
